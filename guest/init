#!/bin/sh
# dmx guest init (PID 1). Runs straight from the initramfs; there is no disk yet.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t cgroup2 cgroup2 /sys/fs/cgroup
hostname dmx
ip link set lo up

for m in virtio_balloon vmw_vsock_virtio_transport virtio_rng; do
	modprobe "$m" || echo "dmx-init: modprobe $m failed" >&2
done

case " $(cat /proc/cmdline) " in
*" dmx.selftest=1 "*)
	echo "DMX-SELFTEST-BEGIN"
	echo "kernel $(uname -r)"
	echo "cpus $(nproc)"
	free -m | awk '/^Mem:/ { print "mem_total_mb " $2; print "mem_used_mb " $3 }'
	for m in virtio_balloon vmw_vsock_virtio_transport; do
		grep -q "^$m " /proc/modules && echo "module $m ok" || echo "module $m missing"
	done
	[ -c /dev/vsock ] && echo "vsock ok" || echo "vsock missing"
	echo "DMX-SELFTEST-END"
	poweroff -f
	;;
esac

# Debug console on hvc0 until the vsock agent exists.
while :; do
	setsid -c /bin/sh -l </dev/hvc0 >/dev/hvc0 2>&1
done
