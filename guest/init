#!/bin/sh
# dmx guest init (PID 1). Runs straight from the initramfs; the data disk is mounted at /var/lib.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run
mount -t devpts devpts /dev/pts
# tmpfs sizes itself from the RAM present at mount. With virtio-mem that is only what the guest
# booted with, so the host passes the ceiling (dmx.memory=<MB>) and /run gets half of it, as before.
run=50%
for arg in $(cat /proc/cmdline); do case "$arg" in dmx.memory=*) run=$((${arg#dmx.memory=} / 2))m; esac; done
mount -t tmpfs -o mode=0755,size=$run tmpfs /run
mount -t cgroup2 cgroup2 /sys/fs/cgroup
echo "+cpu +memory +io +pids" >/sys/fs/cgroup/cgroup.subtree_control || echo "dmx-init: cgroup controllers not enabled" >&2
hostname dmx
ip link set lo up

# The dmx kernel has these built in; the stock Alpine kernel that bootstraps `make kernel` does not.
builtin=/lib/modules/$(uname -r)/modules.builtin
for m in virtio_mmio virtio_balloon virtio_mem vmw_vsock_virtio_transport virtio_rng virtio_net; do
	sed s/-/_/g "$builtin" 2>/dev/null | grep -q "/$m.ko$" || modprobe "$m" || echo "dmx-init: modprobe $m failed" >&2
done

# Data disk: /dev/vda is the host's data.img, a sparse file. A blank disk (first boot) is
# formatted as ext4: one without an ext4 superblock. mke2fs writes the superblock last, so a format
# cut short (the VM stopped during the first boot) is formatted again, while a file system that
# fails to mount is never wiped. mke2fs writes with direct I/O (-D), keeping its metadata out of
# the page cache, and makes a 128 MB journal instead of 512 MB: journal blocks stay allocated on the host once
# written. Mounted with discard: ext4 punches the blocks it frees out of the host file. Block
# bitmaps are read when needed rather than all at mount (~2 MB of guest RAM).
# An existing file system is checked first with e2fsck -p, which replays the journal and repairs
# what is safe to repair unattended; it is quick on a clean disk. Only if that is not enough (a
# power cut that reordered writes, an error ext4 recorded) does e2fsck -fy fix everything it finds,
# with no one to ask, as a VM that cannot mount its disk is worse. Unless e2fsck only found the
# disk clean, its output is added to /var/lib/dmx/log/fsck.log.
# mke2fs and e2fsck are needed for nothing else, so their directory goes (~1.4 MB of guest RAM).
mkfs=/usr/libexec/dmx-mkfs
if [ -b /dev/vda ]; then
	# The ext4 magic, 0xEF53 little-endian, at byte 1080.
	if [ "$(dd if=/dev/vda bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')" != 53ef ]; then
		MKE2FS_CONFIG=$mkfs/mke2fs.conf LD_LIBRARY_PATH=$mkfs $mkfs/mke2fs -q -D -t ext4 -L dmx-data -J size=128 /dev/vda ||
			echo "dmx-init: cannot format /dev/vda" >&2
	else
		fsck() { E2FSCK_CONFIG=$mkfs/e2fsck.conf LD_LIBRARY_PATH=$mkfs $mkfs/e2fsck "$@" /dev/vda >>/run/dmx-fsck.log 2>&1; }
		fsck -p
		checked=$?
		if [ $checked -ge 4 ]; then
			echo "dmx-init: e2fsck -p could not repair /dev/vda ($checked); running e2fsck -fy" >&2
			fsck -fy
			checked=$?
		fi
		[ $checked -ne 0 ] && echo "dmx-init: e2fsck on /dev/vda exited $checked (see /var/lib/dmx/log/fsck.log)" >&2
	fi
	mount -t ext4 -o discard,no_prefetch_block_bitmaps /dev/vda /var/lib || echo "dmx-init: cannot mount /dev/vda on /var/lib" >&2
	if [ -s /run/dmx-fsck.log ] && ! grep -q ': clean, ' /run/dmx-fsck.log && mountpoint -q /var/lib; then
		mkdir -p /var/lib/dmx/log
		{ echo "-- e2fsck at boot $(cat /proc/sys/kernel/random/boot_id)"; cat /run/dmx-fsck.log; } >>/var/lib/dmx/log/fsck.log
	fi
	rm -f /run/dmx-fsck.log
fi
rm -rf "$mkfs"

# x86_64 programs run through QEMU user mode, registered with binfmt_misc: magic and mask from
# QEMU's qemu-binfmt-conf.sh, flags CF as Docker Desktop (linuxkit) and tonistiigi/binfmt use,
# plus P and O. F opens the interpreter now, so containers need no qemu in their file system;
# C (implies O) takes credentials from the x86 binary, so setuid x86 programs work, but qemu then
# runs privileged and still reads QEMU_* variables from the caller (QEMU_LOG_FILENAME writes a
# root-owned file); P passes argv[0] as given (qemu reads it from AT_FLAGS). qemu-x86_64 lives on
# the data disk, so it costs guest RAM only while x86 code runs. It comes xz'd at the end of the
# Docker disk (docker.img, serial dmx-docker; its header gives the sha256, offset and length) and
# is unpacked when the copy on the data disk is missing or another version; otherwise only the
# 4 KB header is read. Without the data disk there is no x86 support.
x86=/var/lib/dmx/qemu
if mountpoint -q /var/lib; then
	img=
	for b in /sys/block/vd*; do
		[ "$(cat "$b/serial" 2>/dev/null)" = dmx-docker ] && img=/dev/${b##*/}
	done
	# dmx-docker 2, payload sha256, length, build key, qemu sha256, offset, length
	[ -n "$img" ] && set -- $(head -c 4096 "$img" | tr -d '\0') && [ "$#" -ge 8 ] && [ "$1 $2" = "dmx-docker 2" ] &&
		[ "$(cat $x86/sha256 2>/dev/null)" != "$6" ] && {
		mkdir -p $x86 && dd if="$img" bs=4096 skip=$(($7 / 4096)) count=$((($8 + 4095) / 4096)) 2>/dev/null | head -c "$8" |
			unxz >$x86/qemu-x86_64.new && chmod 755 $x86/qemu-x86_64.new && mv $x86/qemu-x86_64.new $x86/qemu-x86_64 &&
			sync && echo "$6" >$x86/sha256 || echo "dmx-init: cannot unpack qemu-x86_64" >&2
		# The read-only disk's pages are not needed again; the unpacked copy's go with the idle trim.
		blockdev --flushbufs "$img" 2>/dev/null
	}
	set --
	[ -x $x86/qemu-x86_64 ] && modprobe binfmt_misc && mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc &&
		printf '%s' ':qemu-x86_64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:'$x86/qemu-x86_64:POCF \
			>/proc/sys/fs/binfmt_misc/register || echo "dmx-init: cannot register qemu-x86_64" >&2
fi

# Network: eth0 is dmx's virtio-net, behind a user space NAT in the dmx process (docs/network.md).
# Static, so it is up before the agent starts. These addresses are fixed in UserNet.swift:
# 192.168.127.1 is the gateway and DNS, 192.168.127.254 the host's own 127.0.0.1.
if ip link set eth0 up 2>/dev/null; then
	ip addr add 192.168.127.2/24 dev eth0
	ip route add default via 192.168.127.1
	echo "nameserver 192.168.127.1" >/etc/resolv.conf
	# Docker Desktop's names too; containers get them from the gateway's DNS (UserNetDNS.swift).
	printf '192.168.127.254\thost.dmx.internal host.docker.internal\n192.168.127.1\tgateway.docker.internal\n' >>/etc/hosts
fi

# Host directories shared over dmx's virtio-fs device, mounted at the same path as on the host so
# bind mounts keep their paths. The host passes one dmx.share=<tag>:<rw|ro>:<path> per share
# (paths without whitespace). The host enforces read-only and the share root itself.
set -f  # no globbing of paths
for arg in $(cat /proc/cmdline); do
	case "$arg" in dmx.share=*)
		v=${arg#dmx.share=}; tag=${v%%:*}; v=${v#*:}; mode=${v%%:*}; dir=${v#*:}
		mkdir -p "$dir" && mount -t virtiofs -o "$mode" "$tag" "$dir" || echo "dmx-init: cannot mount share $dir" >&2
	esac
done
set +f

# The host talks to the guest through dmx-agent on vsock port 1024. Restart it if it dies.
(
	while :; do
		/sbin/dmx-agent
		echo "dmx-init: dmx-agent exited with status $?, restarting" >&2
		sleep 1
	done
) </dev/null >/dev/console 2>&1 &

# Debug console, independent of the agent: hvc0 (virtio-console) when there is one, otherwise
# the PL011 UART that dmx's own VMM provides.
tty=/dev/hvc0
[ -e "$tty" ] || tty=/dev/ttyAMA0
while :; do
	setsid -c /bin/sh -l <"$tty" >"$tty" 2>&1 || sleep 1
done
