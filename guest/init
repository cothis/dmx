#!/bin/sh
# dmx guest init (PID 1). Runs straight from the initramfs; the data disk is mounted at /var/lib.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t cgroup2 cgroup2 /sys/fs/cgroup
echo "+cpu +memory +io +pids" >/sys/fs/cgroup/cgroup.subtree_control || echo "dmx-init: cgroup controllers not enabled" >&2
hostname dmx
ip link set lo up

# The dmx kernel has these built in; the stock Alpine kernel that bootstraps `make kernel` does not.
builtin=/lib/modules/$(uname -r)/modules.builtin
for m in virtio_mmio virtio_balloon vmw_vsock_virtio_transport virtio_rng; do
	sed s/-/_/g "$builtin" 2>/dev/null | grep -q "/$m.ko$" || modprobe "$m" || echo "dmx-init: modprobe $m failed" >&2
done

# Data disk: /dev/vda is the host's data.img, a sparse file. A blank disk (first boot) is
# formatted as ext4; only one whose first MB is all zeros, so a file system that fails to mount
# is never wiped. mke2fs writes with direct I/O (-D), keeping its metadata out of the page cache,
# and makes a 128 MB journal instead of 512 MB: journal blocks stay allocated on the host once
# written. Mounted with discard: ext4 punches the blocks it frees out of the host file. Block
# bitmaps are read when needed rather than all at mount (~2 MB of guest RAM).
# mke2fs is needed for nothing else, so its directory goes (~1 MB of guest RAM).
mkfs=/usr/libexec/dmx-mkfs
if [ -b /dev/vda ]; then
	if cmp -s -n 1048576 /dev/vda /dev/zero; then
		MKE2FS_CONFIG=$mkfs/mke2fs.conf LD_LIBRARY_PATH=$mkfs $mkfs/mke2fs -q -D -t ext4 -L dmx-data -J size=128 /dev/vda ||
			echo "dmx-init: cannot format /dev/vda" >&2
	fi
	mount -t ext4 -o discard,no_prefetch_block_bitmaps /dev/vda /var/lib || echo "dmx-init: cannot mount /dev/vda on /var/lib" >&2
fi
rm -rf "$mkfs"

# The host talks to the guest through dmx-agent on vsock port 1024. Restart it if it dies.
(
	while :; do
		/sbin/dmx-agent
		echo "dmx-init: dmx-agent exited with status $?, restarting" >&2
		sleep 1
	done
) </dev/null >/dev/console 2>&1 &

# Debug console, independent of the agent: hvc0 (virtio-console) when there is one, otherwise
# the PL011 UART that dmx's own VMM provides.
tty=/dev/hvc0
[ -e "$tty" ] || tty=/dev/ttyAMA0
while :; do
	setsid -c /bin/sh -l <"$tty" >"$tty" 2>&1 || sleep 1
done
