#!/bin/sh
# dmx guest init (PID 1). Runs straight from the initramfs; there is no disk yet.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t cgroup2 cgroup2 /sys/fs/cgroup
echo "+cpu +memory +io +pids" >/sys/fs/cgroup/cgroup.subtree_control || echo "dmx-init: cgroup controllers not enabled" >&2
hostname dmx
ip link set lo up

# The dmx kernel has these built in; the stock Alpine kernel that bootstraps `make kernel` does not.
builtin=/lib/modules/$(uname -r)/modules.builtin
for m in virtio_mmio virtio_balloon vmw_vsock_virtio_transport virtio_rng; do
	sed s/-/_/g "$builtin" 2>/dev/null | grep -q "/$m.ko$" || modprobe "$m" || echo "dmx-init: modprobe $m failed" >&2
done

# The host talks to the guest through dmx-agent on vsock port 1024. Restart it if it dies.
(
	while :; do
		/sbin/dmx-agent
		echo "dmx-init: dmx-agent exited with status $?, restarting" >&2
		sleep 1
	done
) </dev/null >/dev/console 2>&1 &

# Debug console, independent of the agent: hvc0 (virtio-console) when there is one, otherwise
# the PL011 UART that dmx's own VMM provides.
tty=/dev/hvc0
[ -e "$tty" ] || tty=/dev/ttyAMA0
while :; do
	setsid -c /bin/sh -l <"$tty" >"$tty" 2>&1 || sleep 1
done
